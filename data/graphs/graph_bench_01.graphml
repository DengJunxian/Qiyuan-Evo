<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd"><key id="d1" for="edge" attr.name="weight" attr.type="double"/>
<key id="d0" for="edge" attr.name="predicate" attr.type="string"/>
<graph edgedefault="directed"><node id="央行"/>
<node id="流动性"/>
<node id="资本市场预期"/>
<node id="监管"/>
<node id="异常交易监测"/>
<edge source="央行" target="流动性">
  <data key="d0">释放</data>
  <data key="d1">0.9</data>
</edge>
<edge source="央行" target="资本市场预期">
  <data key="d0">稳定</data>
  <data key="d1">0.8</data>
</edge>
<edge source="监管" target="异常交易监测">
  <data key="d0">强化</data>
  <data key="d1">0.7</data>
</edge>
</graph></graphml>